{
  "name": "@onkt/typespec",
  "version": "0.1.0",
  "description": "onekit code generators for TypeSpec: Go, TypeScript, Python, Rust, Dart and Swift servers and clients",
  "license": "MIT",
  "type": "module",
  "repository": { "type": "git", "url": "git+https://github.com/1homsi/onekit.git", "directory": "typespec" },
  "keywords": ["typespec", "codegen", "go", "typescript", "rust", "dart", "swift", "python", "openapi"],
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": { "typespec": "./lib/main.tsp", "types": "./dist/src/index.d.ts", "default": "./dist/src/index.js" }
  },
  "tspMain": "lib/main.tsp",
  "files": ["lib", "dist/src"],
  "scripts": {
    "build": "tsc -p .",
    "test": "npm run build && node --test \"dist/test/**/*.test.js\""
  },
  "peerDependencies": {
    "@typespec/compiler": "^1.17.0",
    "@typespec/http": "^1.17.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@typespec/compiler": "^1.17.0",
    "@typespec/http": "^1.17.0",
    "typescript": "^5.9.0"
  }
}
