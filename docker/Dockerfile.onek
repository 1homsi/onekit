# Multi-stage build for the onek CLI
FROM golang:1.26-alpine@sha256:ce864e7223ac17b1775e6fd0b4c0db580c2eb50e7953a427916379e4b92a1628 AS builder

WORKDIR /build

COPY go.mod go.sum ./
RUN go mod download

COPY . .

RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o /onek ./cmd/onek

FROM alpine:latest@sha256:28bd5fe8b56d1bd048e5babf5b10710ebe0bae67db86916198a6eec434943f8b

COPY --from=builder /onek /usr/local/bin/onek
RUN chmod +x /usr/local/bin/onek

WORKDIR /workspace

ENTRYPOINT ["/usr/local/bin/onek"]
