type EventStream[T any] struct {
	body         io.ReadCloser
	reader       *bufio.Reader
	maxLineBytes int
	err          error
	payload      []byte
	long         []byte
}

func newEventStream[T any](body io.ReadCloser, maxLineBytes int) *EventStream[T] {
	if maxLineBytes <= 0 {
		maxLineBytes = defaultMaxSSELineBytes
	}
	return &EventStream[T]{body: body, reader: bufio.NewReader(body), maxLineBytes: maxLineBytes}
}

func (s *EventStream[T]) readLine() ([]byte, error) {
	part, err := s.reader.ReadSlice('\n')
	if err == nil {
		if len(part) > s.maxLineBytes {
			return nil, fmt.Errorf("SSE line exceeds configured limit")
		}
		return trimEventLine(part), nil
	}
	if err != bufio.ErrBufferFull {
		return nil, err
	}
	s.long = append(s.long[:0], part...)
	for {
		if len(s.long) > s.maxLineBytes {
			return nil, fmt.Errorf("SSE line exceeds configured limit")
		}
		part, err = s.reader.ReadSlice('\n')
		s.long = append(s.long, part...)
		if len(s.long) > s.maxLineBytes {
			return nil, fmt.Errorf("SSE line exceeds configured limit")
		}
		if err == nil {
			return trimEventLine(s.long), nil
		}
		if err != bufio.ErrBufferFull {
			return nil, err
		}
	}
}

func trimEventLine(line []byte) []byte {
	for len(line) > 0 && (line[len(line)-1] == '\n' || line[len(line)-1] == '\r') {
		line = line[:len(line)-1]
	}
	return line
}

func (s *EventStream[T]) Next(event *T) bool {
	s.payload = s.payload[:0]
	hasData := false
	isError := false
	for {
		line, err := s.readLine()
		if err != nil {
			if err != io.EOF {
				s.err = err
			}
			return false
		}
		if len(line) == 0 {
			if !hasData {
				isError = false
				continue
			}
			if isError {
				s.err = fmt.Errorf("stream error: %s", s.payload)
				return false
			}
			if err := unmarshalJSONValue(s.payload, event); err != nil {
				s.err = err
				return false
			}
			return true
		}
		if line[0] == ':' {
			continue
		}
		field, value := line, []byte(nil)
		if i := bytes.IndexByte(line, ':'); i >= 0 {
			field, value = line[:i], line[i+1:]
			if len(value) > 0 && value[0] == ' ' {
				value = value[1:]
			}
		}
		switch string(field) {
		case "event":
			isError = string(value) == "error"
		case "data":
			if hasData {
				s.payload = append(s.payload, '\n')
			}
			s.payload = append(s.payload, value...)
			hasData = true
		}
	}
}

func (s *EventStream[T]) Err() error   { return s.err }
func (s *EventStream[T]) Close() error { return s.body.Close() }
