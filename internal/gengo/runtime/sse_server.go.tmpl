type SSESender interface {
	Send(event any) error
	SendWithEvent(eventType string, event any) error
	Flush()
}

type sseSender struct {
	mu        sync.Mutex
	w         http.ResponseWriter
	rc        *http.ResponseController
	started   bool
	eventName func(any) string
	frame     []byte
}

const defaultSSEHeartbeat = 15 * time.Second

func newSSESender(w http.ResponseWriter, eventName func(any) string) *sseSender {
	return &sseSender{w: w, rc: http.NewResponseController(w), eventName: eventName}
}

func (s *sseSender) heartbeat(ctx context.Context, interval time.Duration, set bool) func() {
	if !set {
		interval = defaultSSEHeartbeat
	}
	if interval <= 0 {
		return func() {}
	}
	done := make(chan struct{})
	var wg sync.WaitGroup
	wg.Add(1)
	go func() {
		defer wg.Done()
		ticker := time.NewTicker(interval)
		defer ticker.Stop()
		for {
			select {
			case <-done:
				return
			case <-ctx.Done():
				return
			case <-ticker.C:
				s.mu.Lock()
				if !s.started {
					s.start()
				}
				if _, err := fmt.Fprint(s.w, ": ping\n\n"); err == nil {
					_ = s.flush()
				}
				s.mu.Unlock()
			}
		}
	}()
	return func() { close(done); wg.Wait() }
}

func (s *sseSender) Sent() bool {
	s.mu.Lock()
	defer s.mu.Unlock()
	return s.started
}

func (s *sseSender) Send(event any) error {
	name := ""
	if s.eventName != nil {
		name = s.eventName(event)
	}
	return s.SendWithEvent(name, event)
}

func validSSEEventName(name string) bool {
	for _, c := range name {
		if !(c >= 'a' && c <= 'z' || c >= 'A' && c <= 'Z' || c >= '0' && c <= '9' || c == '_' || c == '-' || c == '.') {
			return false
		}
	}
	return true
}

func (s *sseSender) start() {
	s.started = true
	s.w.Header().Set("Content-Type", "text/event-stream")
	s.w.Header().Set("Cache-Control", "no-cache")
	s.w.Header().Set("Connection", "keep-alive")
	s.w.WriteHeader(http.StatusOK)
}

func (s *sseSender) SendWithEvent(eventType string, event any) error {
	if !validSSEEventName(eventType) {
		return fmt.Errorf("invalid SSE event name %q", eventType)
	}
	s.mu.Lock()
	defer s.mu.Unlock()
	frame := s.frame[:0]
	if eventType != "" {
		frame = append(frame, "event: "...)
		frame = append(frame, eventType...)
		frame = append(frame, '\n')
	}
	frame = append(frame, "data: "...)
	mark := len(frame)
	var err error
	if a, ok := event.(interface{ AppendJSON([]byte) ([]byte, error) }); ok {
		frame, err = a.AppendJSON(frame)
	} else {
		var raw []byte
		raw, err = json.Marshal(event)
		frame = append(frame, raw...)
	}
	if err != nil {
		s.frame = frame[:0]
		return err
	}
	frame = sseDataLines(frame, mark)
	frame = append(frame, '\n', '\n')
	if !s.started {
		s.start()
	}
	_, err = s.w.Write(frame)
	if cap(frame) <= 64<<10 {
		s.frame = frame[:0]
	} else {
		s.frame = nil
	}
	if err != nil {
		return err
	}
	return s.flush()
}

func sseDataLines(frame []byte, mark int) []byte {
	broken := false
	for _, c := range frame[mark:] {
		if c == '\n' || c == '\r' {
			broken = true
			break
		}
	}
	if !broken {
		return frame
	}
	out := make([]byte, 0, len(frame)+16)
	out = append(out, frame[:mark]...)
	for i := mark; i < len(frame); i++ {
		switch frame[i] {
		case '\r':
			if i+1 < len(frame) && frame[i+1] == '\n' {
				i++
			}
			out = append(out, "\ndata: "...)
		case '\n':
			out = append(out, "\ndata: "...)
		default:
			out = append(out, frame[i])
		}
	}
	return out
}

func (s *sseSender) flush() error {
	if err := s.rc.Flush(); err != nil && !errors.Is(err, http.ErrNotSupported) {
		return err
	}
	return nil
}

func (s *sseSender) Flush() {
	s.mu.Lock()
	defer s.mu.Unlock()
	_ = s.flush()
}
