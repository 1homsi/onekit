
package wsj

enum Level {
  LOW
  MID
  HIGH
}

message Inner {
  name: string
  n: int32
}

message All {
  s: string
  b: bool
  i32: int32
  u32: uint32
  i64: int64
  u64: uint64
  i64n: int64 @encode(number)
  f32: float32
  f64: float64
  by: bytes
  lvl: Level
  ts: timestamp
  j: json
  m: map[string, Inner]
  inner: Inner
  inners: Inner[]
  ss: string[]
  i64s: int64[]
  lvls: Level[]
  os: string?
  oi64: int64?
  ob: bool?
  olvl: Level?
  choice: oneof(discriminator: "kind") {
    a: Inner @tag("a")
    t: string @tag("t")
    n: int64 @tag("n")
    l: Level @tag("l")
  }
}

service S {
  base_path: "/v1"

  f(All) -> All @ws("/x")
}
