
package check

message PingRequest {}
message StatsRequest {}
message Stats { active: int32 }
message Frame {
  payload: oneof {
    ping: PingRequest @tag("ping")
    stats: Stats @tag("stats")
  }
}

service Live {
  stream(Frame) -> Frame @ws("/live")
  ping(PingRequest) -> PingRequest @ws("/ping")
  stats(StatsRequest) -> Stats @get("/stats")
}
