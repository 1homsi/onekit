
package app.models

message User {
  id: string
  name: string @len(2, 100)
  email: string @email
}

message CreateUserRequest {
  name: string @len(2, 100)
  email: string @email
}

message GetUserRequest {
  id: string
}

message NotFoundError @status(404) {
  resource_type: string
  resource_id: string
}
