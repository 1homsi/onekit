
package app

message Empty {}

message Slug {
  slug: string
}

message Item {
  id: string
}

service Apps {
  base_path: "/apps"

  bundle(Slug) -> Empty @get("/{slug}/bundle.js") @http("application/javascript") @guard("app/use/:slug")
  proxy(Slug) -> Empty @any("/{slug}/proxy") @http
  info(Slug) -> Item @get("/{slug}/info")
}
