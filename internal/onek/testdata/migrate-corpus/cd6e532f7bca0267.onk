package example.todos

enum Status { OPEN DONE }

message Todo {
  id: string
  title: string @required @len(1, 200)
  status: Status
}

message GetTodo { id: string @required }
message NotFound @status(404) { message: string }

service Todos {
  base_path: "/v1"

  getTodo(GetTodo) -> Todo | NotFound @get("/todos/{id}")
}
