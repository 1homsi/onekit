package app

message Row {
  id: string
  name: string @len(1, 20)
  tags: string[]
}

message List {
  rows: Row[] @max_items(500)
  @rule("self.rows.all(r, r.id != '')", "every row needs an id")
}

message Save {
  rows: Row[]
  note: string
}

message Query { limit: int32 @query }

service Rows {
  base_path: "/v1"
  list(Query) -> List @get("/rows")
  save(Save) -> List @post("/rows")
}
