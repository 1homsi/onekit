package app

message Health {
  status: string
  // keep this last - ordering matters to the mobile client
}

enum Color {
  RED
  // more colors later
}

message Frame {
  payload: oneof(discriminator: "type") {
    a: Health
    // reserved: b
  }
}

service S {
  base_path: "/v1"
  headers: {
    "X-A": string
    // "X-B" retired
  }

  get(Health) -> Health @post("/h") {
    headers: {
      "X-C": string
      // rpc header note
    }
    // rpc body note
  }
  // service tail note
}

// final note
/// dangling doc at EOF
