
package check

message Item { id: string }
message GetItem { id: string }
message Nothing {}

service Items {
  base_path: "/items/v1"

  get(GetItem) -> Item @get("/items/{id}") @requires("items:read")
  remove(GetItem) -> Nothing @delete("/items/{id}") @requires("items:read", "items:write")
  ping(Nothing) -> Nothing @get("/ping")
}
