package app

enum ResourceType {
  REST @json("rest")
  S3 @json("s3")
  SQL @json("sql")
}

message SqlOptions {
  host: string
  port: int32
}

message Options {
  sql: SqlOptions?
}

message CreateResource {
  name: string
  type: ResourceType
  options: Options?
  tags: string[]
  labels: map[string, SqlOptions]
  size: int64
  created: timestamp?
  ratio: float32
}

message Resource { name: string }

message Wrapped {
  id: string
  options: Options
}

message Counted {
  id: string
  count: int64[]
}

service Resources {
  create(CreateResource) -> Resource @post("/api/v1/resources")
  wrap(Wrapped) -> Resource @put("/api/v1/wrapped/{id}") @body("options")
  count(Counted) -> Resource @put("/api/v1/counted/{id}") @body("count")
}
