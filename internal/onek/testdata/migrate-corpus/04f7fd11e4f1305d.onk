
package app
/// A stored note.
///
/// Quotes """ and \ stay intact.
message Note {
  /// Unique identifier.
  id: string
}
/// Nothing inside.
message Empty {}
/// Visibility of a note.
enum Visibility { PRIVATE PUBLIC }
/// Raised when a note is missing.
message Missing @status(404) { id: string }
/// Manages notes.
service Notes {
  /// Fetch one note.
  get(Note) -> Note | Missing @get("/notes/{id}")
}
